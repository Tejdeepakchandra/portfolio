# GitHub Personal Access Token (optional, but recommended)
# Get one at: https://github.com/settings/tokens
# Permissions needed: read:user, public_repo
VITE_GITHUB_TOKEN=your_github_token_here

# LeetCode and GitHub usernames are hardcoded in components
# Update them in:
# - src/components/LeetCode.jsx (LEETCODE_USERNAME)
# - src/components/GitHubActivity.jsx (GITHUB_USERNAME)
